# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "src/env.js"
# should be updated accordingly.

# Prisma
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# Under high concurrency, size the pool per process, for example
# ?connection_limit=20&pool_timeout=10. Keep the total of all processes
# below the database max_connections.
DATABASE_URL="postgresql://postgres:local_demo_only@127.0.0.1:55432/mon2api"

# App metadata
APP_ENV="development"
NEXT_PUBLIC_APP_ENV="development"
# Optional WalletConnect/Reown project ID. Browser extensions work without it.
# This is a public application identifier, never a wallet private key.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""
LOG_LEVEL="info"

# Security
# Comma-separated list. Empty means same-origin/browserless requests only.
ALLOWED_ORIGINS=""
RATE_LIMIT_ENABLED="true"
RATE_LIMIT_REQUESTS="60"
# Quota per verified API key, connector or signed-in wallet. Anonymous traffic
# and failed credentials use RATE_LIMIT_REQUESTS per IP instead.
RATE_LIMIT_CREDENTIAL_REQUESTS="600"
RATE_LIMIT_WINDOW_SECONDS="60"
RATE_LIMIT_MAX_BUCKETS="10000"
# Default: do not trust forwarded IP headers; anonymous clients share a bucket per route.
# Set to x-forwarded-for, x-real-ip, or cf-connecting-ip ONLY behind a proxy
# that overwrites that header with one client IP and prevents direct origin access.
RATE_LIMIT_IP_HEADER="none"

# Optional shared REST/tRPC rate limit backend. Without these, limits are per process.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry, optional. Leave empty to disable local error/performance reporting.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0.1"

# PostHog, optional. Leave the key empty to disable analytics.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Optional later if you add Clerk
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
# CLERK_SECRET_KEY=""

# Multichain settlement. Select a chain and its native asset, USDT or USDC.
# The example below configures Ethereum mainnet with ETH.
# Ethereum=1, Base=8453, Arbitrum=42161, Optimism=10, BSC=56,
# Polygon=137, Avalanche=43114, Robinhood Chain=4663.
TOKEN2API_MODE="evm"
SETTLEMENT_CHAIN_ID="1"
SETTLEMENT_ASSET="ETH"
# Optional HTTPS operator RPC. Public wallet RPC comes from the chain registry.
EVM_RPC_URL=""
# Required for USDT/USDC: operator-verified contract on the selected chain.
# The deployer reads decimals() from this contract; it does not infer provenance.
SETTLEMENT_TOKEN_ADDRESS=""
ALLOW_DEMO="false"
# Canonical public origin, used in buyer base_url. Set HTTPS deployment origin remotely.
APP_ORIGIN="http://localhost:3000"
# Generate a random value of at least 32 characters. Required outside development.
SESSION_PASSWORD=""
# Exact trusted gateway origins, without /v1. Set by the operator.
UPSTREAM_ALLOWED_ORIGINS="http://127.0.0.1:8080,http://localhost:8080"
# Required for remote deployment; never prefix a signing key NEXT_PUBLIC_.
METER_PRIVATE_KEY=""
DEPLOYER_PRIVATE_KEY=""
TREASURY_ADDRESS=""
# Optional isolated data directory. Default .runtime/evm/<chainId>-<asset> (.runtime in local mode).
TOKEN2API_DATA_DIR=""

# Public deployment metadata JSON for read-only/ephemeral filesystems.
# Otherwise the app reads <TOKEN2API_DATA_DIR>/chain.json.
# Native assets require token=zero address and tokenDecimals=18.
# Stablecoins require a verified ERC20 address and explicit tokenDecimals (6–18).
# Each chain/asset deployment requires a fresh database and data directory.
CHAIN_CONFIG_JSON=""
# Only for docker-compose.app.yml, choose a separate strong database password.
POSTGRES_PASSWORD=""

# Development-only frontend preview without database or chain.
NEXT_PUBLIC_UI_PREVIEW="false"

# Optional merchant connector CLI secrets. These belong to the merchant machine,
# not the platform deployment. Prefer hidden input or the process manager's credential store.
# TOKEN2API_CONNECTOR_TOKEN=""
# TOKEN2API_UPSTREAM_KEY=""
